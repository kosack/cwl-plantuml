#!/usr/bin/env cwl-runner
%YAML 1.1
---
cwlVersion: v1.2
class: CommandLineTool
label: Apply Models
doc: |
  Apply reconstruction models to existing event data. (*DPPS-UC-130-1.4*). Applies
  the reconstruction model(s) to the input file and writes an output with
  new columns added.

baseCommand: ctapipe-apply-models

stderr: $(inputs.output_filename).log

inputs:
  log_level:
    type:
      type: enum
      symbols: [DEBUG, INFO, WARN, ERROR, CRITICAL]
    doc: |
      Logging level of the tool. Log output is written to stderr and captured
      in the ``log`` output.
    default: INFO
    inputBinding:
      prefix: --log-level

  config:
    type:
      type: array
      items: File
      inputBinding:
        prefix: --config
    default: []
    doc: |
      Ordered configuration files, passed as repeated ``--config`` arguments.
      Later files override conflicting settings from earlier files.
      Sets the parameters for the ctapipe-apply-models tool.
  events:
    type: File
    inputBinding:
      prefix: --input
    doc: |
      Event file in ctapipe-compatible HDF5 format containing all the required
      input columns for the given models.

  output_filename:
    type: string
    doc: filename of output events file
    inputBinding:
      prefix: --output

  models:
    doc: |
      One or more serialized reconstruction models, as generated by the
      ``ctapipe-train-<model>`` tools. The order is important if models use
      parameters generated by a previous model.
    type:
      type: array
      items: File
      inputBinding:
        prefix: --reconstructor


  provenance_log_filename:
    type: string
    doc: file in which to write the local provenance.
    default: apply_models.provenance.log
    inputBinding:
      prefix: --provenance-log

outputs:
  applied_events:
    type: File
    doc: Same as input file, but with new columns added for each model that was applied.
    outputBinding:
      glob: $(inputs.output_filename)
  provenance_log:
    type: File
    doc: ctapipe-format provenance log for this step.
    outputBinding:
      glob: $(inputs.provenance_log_filename)

  log:
    type: stderr
    doc: |
      Log output (stderr) of the tool. When running with ``cwltool``, use
      ``--log-dir`` to also keep logs of intermediate workflow steps, including
      those that failed.

$namespaces:
  s: https://schema.org/
s:license: https://spdx.org/licenses/BSD-3-Clause
s:codeRepository: https://gitlab.cta-observatory.org/cta-computing/dpps/datapipe/datapipe
